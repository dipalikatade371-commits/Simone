<%- include('header.ejs') %>

<div class="main">

  <header class="topbar">
    <h2>Add Education Record</h2>
    <div class="user">Welcome, Admin</div>
  </header>

  <section class="content">
<div class="panel">

  <h3>Add Education</h3>

  <p class="hint">Add your education details here.</p>

  <form class="form" action="/admin/education_save" method="post">

    <div class="row">

      <div class="field">
        <label for="year">Education Year</label>
        <input id="year" type="text" name="e_year">
      </div>

      <div class="field">
        <label for="degree">Education Degree</label>
        <input id="degree" type="text" name="e_degree">
      </div>

    </div>

    <div class="field">
      <label for="university">Education University</label>
      <input id="university" type="text" name="e_uni">
    </div>

    <div class="field">
      <label for="notes">Education Description</label>
      <textarea id="notes" name="e_desc" placeholder="Short note..."></textarea>
    </div>

    <div class="actions">
      <button class="btn" type="submit">Save</button>
      <button class="btn btn-ghost" type="reset">Clear</button>
    </div>

  </form>

</div>

  </section>

</div>

</div>

<%- include('footer.ejs') %>
