



<%-include('header.ejs'); %>
      <div class="main">
        <header class="topbar">
          <h2>Service table</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>Service Table</h3>
            <p class="hint">Sample rows for layout only.</p>

            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Icons</th>
                  <th>Title</th>
                   <th>Desc</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% for (var i=0;i<service.length;i++){ %>
                <tr></tr>
            
                  <td><%=service[i].sid%></td>
                  <td><%=service[i].s_icons %></td>
                   <td><%=service[i].s_title %></td>
                  <td><%=service[i].s_desc %></td>
                 
                  <td>
                     <a href="/admin/delete_service/<%=service[i].sid%>">
                            <span class="badge badge-off">Delete</span>
                        </a>
                     
                </td>
                </tr>
              <% } %>
              </tbody>

            </table>
          </div>
        </section>
      </div>
    </div>
    
<%-include('footer.ejs'); %>
  

  
