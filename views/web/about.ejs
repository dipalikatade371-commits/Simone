<%-include('header.ejs') %>

    <section class="section about" id="about">

      <div class="container">

        <div class="section-head">

          <div class="section-bg-title">About Me</div>

          <h2 class="section-title">Know Me More</h2>

        </div>


        <div class="about__grid">

          <div>

            <h3>
              I'm <em><%=data.a_name%></em>,
              a <%=data.a_title%>
            </h3>


            <p>
              <%=data.a_desc1%>
            </p>


            <p>
              <%=data.a_desc2%>
            </p>


            <ul class="about-meta">

              <li>
                <strong>Name:</strong>
                <%=data.a_name%>
              </li>

              <li>
                <strong>Email:</strong>
                <%=data.a_email%>
              </li>

              <li>
                <strong>Age:</strong>
                <%=data.a_age%>
              </li>

              <li>
                <strong>From:</strong>
                <%=data.a_from%>
              </li>

            </ul>

<a class="btn btn--accent" href="/files/Simone_CV.pdf" download>
    Download CV
</a>
          </div>


          <div class="stats">

            <div class="stat">

              <strong>
                <%=data.a_experience%>
              </strong>

              <span>
                Years Experience
              </span>

            </div>


            <div class="stat">

              <strong>
                <%=data.a_clients%>
              </strong>

              <span>
                Happy Clients
              </span>

            </div>


            <div class="stat">

              <strong>
                <%=data.a_projects%>
              </strong>

              <span>
                Projects Done
              </span>

            </div>


            <div class="stat">

              <strong>
                <%=data.a_awards%>
              </strong>

              <span>
                Awards
              </span>

            </div>

          </div>

        </div>

      </div>

    </section>

<%-include('footer.ejs') %>